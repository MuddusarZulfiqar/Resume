# Server-only — never prefix with NEXT_PUBLIC.

# Powers the AI terminal widget (/api/chat). Without it the terminal replies
# with an "AI is offline" message instead of live answers.
OPENAI_API_KEY=""
# Optional — defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"

# Powers the GitHub contribution graph on /project. A classic PAT with NO
# scopes is enough for public data. Leave unset and the graph hides itself.
GITHUB_TOKEN=""
